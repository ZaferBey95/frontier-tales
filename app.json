{
  "expo": {
    "name": "Frontier Tales",
    "slug": "frontier-tales",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontiertales",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zaferbey95.frontiertales"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2E6CB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zaferbey95.frontiertales"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Frontier Tales",
      "shortName": "Frontier",
      "themeColor": "#9C3D1E",
      "backgroundColor": "#F2E6CB",
      "lang": "tr"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2E6CB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#1B130D",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "backgroundColor": "#F2E6CB"
  }
}
